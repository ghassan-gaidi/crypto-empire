# Dominion — environment template. Copy to .env (NEVER commit .env).
# Required in production (app refuses to boot without these outside dev):
FLASK_SECRET=generate-with-python-secrets-token_urlsafe-64
ADMIN_SECRET=generate-with-python-secrets-token_urlsafe-64
# Cron / webhook shared secrets (generate random values, store in GH Actions):
WHALE_REFRESH_SECRET=
ALERT_CHECK_SECRET=
POLAR_WEBHOOK_SECRET=
# Optional integrations:
TELEGRAM_TOKEN=                  # Telegram bot token (daemon + webhook notify)
WHALE_ALERT_CHAT_IDS=            # comma-separated chat IDs for whale alerts
WHALE_RPC_URL=https://ethereum-rpc.publicnode.com
PREMIUM_API_KEYS=                # comma-separated premium API keys
BASE_URL=https://crypto-empire-ten.vercel.app
HTTP_TIMEOUT=15
SPONSORED_COIN_ID=bitcoin
SPONSORED_COIN_MSG=Bitcoin — The Original Asset
DATA_DIR=                        # default: ~/dominion/data (server), /tmp (Vercel)
