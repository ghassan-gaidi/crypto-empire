[Unit]
Description=Dominion Telegram Bot
After=network.target

[Service]
Type=simple
User=leo
WorkingDirectory=/home/leo/projects/crypto-empire-public
EnvironmentFile=/home/leo/projects/crypto-empire-public/.env
ExecStart=/home/leo/projects/crypto-empire-public/venv/bin/python /home/leo/projects/crypto-empire-public/bot.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
